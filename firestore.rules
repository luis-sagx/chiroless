rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // REGLA DE ADMINISTRADOR / INVESTIGADOR
    match /{document=**} {
      allow read: if request.auth != null && request.auth.token.email == 'luis@espe.edu.ec';
    }

    // REGLAS DE USUARIOS NORMALES   
    // Colección users
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Categorías del usuario, aisladas y editables solo por su propietario.
      match /transactionCategories/{categoryType} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId
          && categoryType in ['expense', 'income'];
      }
    }
    
    // Colección expenses
    match /expenses/{expenseId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Colección incomes
    match /incomes/{incomeId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Colección budgets
    match /budgets/{budgetId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Colección achievements
    match /achievements/{achievementId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Colección metrics
    match /metrics/{metricId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Series de transacciones periódicas, aisladas por propietario.
    match /recurringTransactions/{seriesId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /skippedOccurrences/{occurrenceDate} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == get(
            /databases/$(database)/documents/recurringTransactions/$(seriesId)
          ).data.userId;
      }
    }
  }
}
