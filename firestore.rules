rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // REGLA DE ADMINISTRADOR / INVESTIGADOR
    match /{document=**} {
      allow read: if request.auth != null && request.auth.token.email == 'luis@espe.edu.ec';
    }

    // REGLAS DE USUARIOS NORMALES   
    // Colección users
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Categorías del usuario, aisladas y editables solo por su propietario.
      match /transactionCategories/{categoryType} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId
          && categoryType in ['expense', 'income'];
      }
      // Private voluntary ranking preferences; never exposed with user profiles.
      match /leaderboard/{profileId} {
        allow read: if request.auth != null && request.auth.uid == userId && profileId == 'profile';
        allow create, update: if request.auth != null && request.auth.uid == userId
          && profileId == 'profile'
          && request.resource.data.keys().hasOnly(['enabled', 'alias', 'publishedMonths'])
          && request.resource.data.keys().hasAll(['enabled', 'alias', 'publishedMonths'])
          && request.resource.data.enabled is bool
          && request.resource.data.alias is string
          && request.resource.data.alias.size() <= 24
          && (!request.resource.data.enabled || request.resource.data.alias.size() >= 2)
          && request.resource.data.publishedMonths is list;
      }
    }
    // The shared projection contains no amounts, identity details or transactions.
    match /leaderboardMonths/{month}/entries/{userId} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.keys().hasOnly(['alias', 'savingsPercent', 'updatedAt'])
        && request.resource.data.keys().hasAll(['alias', 'savingsPercent', 'updatedAt'])
        && request.resource.data.alias is string
        && request.resource.data.alias.size() >= 2 && request.resource.data.alias.size() <= 24
        && request.resource.data.savingsPercent is number
        // Finite values subtract to zero; NaN and either infinity do not.
        && (request.resource.data.savingsPercent - request.resource.data.savingsPercent) == 0
        && request.resource.data.savingsPercent <= 100
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(userId)/leaderboard/profile).data.enabled == true
        && getAfter(/databases/$(database)/documents/users/$(userId)/leaderboard/profile).data.alias == request.resource.data.alias;
    }
    
    // Colección expenses
    match /expenses/{expenseId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Colección incomes
    match /incomes/{incomeId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Colección budgets
    match /budgets/{budgetId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Colección achievements
    match /achievements/{achievementId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Colección metrics
    match /metrics/{metricId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Series de transacciones periódicas, aisladas por propietario.
    match /recurringTransactions/{seriesId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /skippedOccurrences/{occurrenceDate} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == get(
            /databases/$(database)/documents/recurringTransactions/$(seriesId)
          ).data.userId;
      }
    }
  }
}
